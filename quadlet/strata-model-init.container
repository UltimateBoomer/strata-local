[Unit]
Description=Strata model download and preparation

[Container]
Image=localhost/strata-local:hip
Entrypoint=python
Exec=/usr/local/lib/strata-local/model-init.py
Volume=strata-data.volume:/data
Volume=@REPO@/config/model.json:/config/model.json:ro,z
Volume=@REPO@/config/server.json:/config/server.json:ro,z
Environment=STRATA_VERIFY_EXISTING=@VERIFY_EXISTING@
Secret=strata-local-hf-token,target=hf_token

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=infinity

{
  "exe": "/opt/strata/engine/strata",
  "cwd": "/opt/strata",
  "tokenizer": "/data/pack-q2/tokenizer",
  "backend": "hip",
  "log": "/data/strata.log",
  "turn_slice_s": 30,
  "models": {
    "q2": "server-q2.json",
    "q3": "server-q3.json"
  },
  "model_session_dir": "/data/sessions",
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0.0,
    "presence_penalty": 0.0,
    "repetition_penalty": 1.0
  },
  "env": {
    "STRATA_HIPBLASLT_TUNING": "/config/gfx1101-hipblaslt-100000.txt",
    "STRATA_RESIDENT_HEADROOM_GIB": "1"
  },
  "args": [
    "--conversation-cache-mib",
    "16384",
    "--conversation-cache-slots",
    "0",
    "--conversation-cache-dir",
    "/data/convcache",
    "--conversation-cache-min-tokens",
    "4096",
    "--conversation-cache-skip-tail",
    "4096",
    "--conversation-cache-live-tail",
    "4096",
    "--conversation-cache-min-free-mib",
    "1024",
    "--resident-experts",
    "--spec",
    "4",
    "--spec-min-p",
    "0.7",
    "--max-context",
    "200000",
    "--kv",
    "int8",
    "--pool-workers",
    "0",
    "--adapt-every",
    "0",
    "--pcie-frac",
    "0.5",
    "--vram-reserve-mib",
    "1024",
    "--vision"
  ],
  "vision": {
    "exe": "/opt/strata/engine/strata-vision",
    "mmproj": "/data/model-q2/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
    "model": "/data/model-q2/Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00002.gguf",
    "gpu": false,
    "threads": 8,
    "max_tokens": 300
  },
  "slot_save_path": "/data/sessions"
}

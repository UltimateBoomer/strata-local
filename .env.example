# This machine's deployment settings, which mise loads (mise.toml) for the Makefile. Copy to .env, which is not
# committed, and fill in. Leave DEPLOY_HOST unset to run the server on this machine.
#
# The deploy host: an SSH host name (its hostname too, so the Makefile knows when it runs there). The Quadlet unit is
# managed over SSH to it; everything else goes through its Podman socket.
DEPLOY_HOST=
# The Podman connection to its socket (podman system connection add; default: DEPLOY_HOST).
DEPLOY_CONNECTION=
# The address the server listens on there, so other machines reach it (default: 127.0.0.1).
DEPLOY_ADDRESS=
